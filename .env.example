# Copia este archivo a .env.local y NO pongas claves reales.
# En desarrollo todo corre contra el Firebase Emulator Suite (proyecto "demo-", sin credenciales).
# Producción vive solo en las variables de entorno de Vercel.

# --- Emulador (desarrollo) ---
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# --- Firebase, servidor (en producción los pone Vercel; aquí valores falsos) ---
FIREBASE_PROJECT_ID=demo-lista-deseos
FIREBASE_CLIENT_EMAIL=falso@demo-lista-deseos.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="falso"

# --- Firebase, navegador (con el emulador basta un valor cualquiera) ---
NEXT_PUBLIC_FIREBASE_API_KEY=falso-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-lista-deseos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-lista-deseos
NEXT_PUBLIC_FIREBASE_APP_ID=falso-app-id
