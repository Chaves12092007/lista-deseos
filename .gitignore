# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datos locales (exportaciones del emulador) y secretos: no se suben a git
/data/
/secrets/

# secretos y claves (nunca al repositorio)
*.key
*firebase-adminsdk*.json
secrets/

# datos locales del emulador de Firebase
data/
firebase-debug.log
firestore-debug.log
ui-debug.log

# cobertura de pruebas
/coverage

# Archivos que el sandbox de Claude Code "tapa" dentro del proyecto (aparecen vacíos)
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.gitmodules
.ripgreprc
.mcp.json
.idea/
.vscode/
.claude/commands/
