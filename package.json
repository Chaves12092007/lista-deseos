{
  "name": "lista-deseos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "firebase emulators:start --project demo-lista-deseos --import=./data/emulator --export-on-exit=./data/emulator",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:hooks": "node --test .claude/hooks/guard.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:hooks",
    "check:full": "npm run check && npm run build",
    "check:env": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/check-env.ts",
    "seed": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
